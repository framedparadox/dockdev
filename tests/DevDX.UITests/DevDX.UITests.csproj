<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Design doc §24: FlaUI, opt-in, needs a real desktop. Deliberately NOT in DevDX.slnx — these
    drive a live window through UI Automation, so they need a logged-in interactive session with a
    visible desktop and they take seconds per case rather than milliseconds. A headless CI agent
    would fail every one of them for reasons that have nothing to do with the code, so opting in is
    explicit: set DEVDX_UITESTS=1, or run scripts/run-ui-tests.ps1 which sets it for you.

    No ProjectReference to DevDX. The tests drive the shipped executable through automation, not
    its types — the point is to exercise what a user gets, and a reference would let a test reach
    past the UI into the app's internals and stop testing the thing it claims to.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DevDX.UITests</RootNamespace>

    <Platforms>x64;ARM64</Platforms>
    <DevDXArchitecture Condition="'$(Platform)' == 'ARM64'">arm64</DevDXArchitecture>
    <DevDXArchitecture Condition="'$(DevDXArchitecture)' == ''">x64</DevDXArchitecture>
    <RuntimeIdentifier>win-$(DevDXArchitecture)</RuntimeIdentifier>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />

    <!--
      Pinned to override FlaUI's transitive 5.0.2, which carries a known critical advisory
      (GHSA-rxg9-xrhp-64gj). FlaUI needs System.Drawing.Common for window capture, which is how the
      theme test observes a repaint — there is no UI Automation property that says "this repainted".
      Note this is a *test* dependency only: design doc §26 records that the app itself has no
      System.Drawing.Common, and that stays true.
    -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
