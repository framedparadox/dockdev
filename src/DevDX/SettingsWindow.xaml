<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevDX.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DevDX.Localization"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- NOTE: WinUI 3's Window is not a FrameworkElement and has no Resources property, so
         shared resources live on the root Grid, not on <Window.Resources>. -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <!-- The dimmed second line under a setting's or a tool's name.

                 This exists as a style, and is reached by key from the code that builds the Dock,
                 Home and Tools cards, because that code cannot look the brush up for itself. This
                 window picks its own Light/Dark theme from the user's choice, which is not
                 necessarily the application's, and `Application.Current.Resources["…"]` resolves
                 against the application's — so a Light window was painting its descriptions in the
                 Dark theme's near-white and they vanished into the card. A {ThemeResource} inside a
                 Style is resolved against the element the style lands on, which is the right theme
                 by construction. -->
            <Style x:Key="SecondaryCaption" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Localize Key=Settings.Title}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="HomeNav" Content="{loc:Localize Key=Nav.Home}"
                                         AutomationProperties.AutomationId="SettingsNavHome"
                                         IsSelected="True" Icon="Home" Tag="home" />
                <muxc:NavigationViewItem x:Name="GeneralNav" Content="{loc:Localize Key=Nav.General}"
                                         AutomationProperties.AutomationId="SettingsNavGeneral"
                                         Icon="Setting" Tag="general" />
                <muxc:NavigationViewItem x:Name="AppearanceNav" Content="{loc:Localize Key=Nav.Appearance}"
                                         AutomationProperties.AutomationId="SettingsNavAppearance"
                                         Tag="appearance">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="ShortcutsNav" Content="{loc:Localize Key=Nav.Shortcuts}"
                                         AutomationProperties.AutomationId="SettingsNavShortcuts"
                                         Tag="shortcuts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="DockNav" Content="{loc:Localize Key=Nav.Dock}"
                                         AutomationProperties.AutomationId="SettingsNavDock"
                                         Tag="dock">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="ToolsNav" Content="{loc:Localize Key=Nav.Tools}"
                                         AutomationProperties.AutomationId="SettingsNavTools"
                                         Icon="AllApps" Tag="tools" />
                <muxc:NavigationViewItem x:Name="AboutNav" Content="{loc:Localize Key=Nav.About}" Tag="about"
                                         AutomationProperties.AutomationId="SettingsNavAbout">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid Padding="32,24,32,24">
                <!-- ==================== HOME ====================
                     Every tool in the catalog, as one flat launcher. Deliberately ungrouped: the
                     Add-Tool window groups by category because you are choosing what to pin, and
                     the categories are how you narrow that choice. Here you already know which
                     tool you want, and six headings between you and it is friction. The order is
                     still the catalog's, which runs format → encode → privacy → text → generate →
                     numbers, so related tools stay neighbours. -->
                <Grid x:Name="HomePanel" RowSpacing="12"
                      AutomationProperties.AutomationId="SettingsHomePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Localize Key=Nav.Home}"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="{loc:Localize Key=Home.Hint}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Two cards to a row. The columns are declared here and the rows are added
                         in code (RebuildHome): the card count is the catalog's, not the
                         designer's. Padding on the right keeps the last column clear of the
                         scrollbar rather than tucked under it. -->
                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <Grid x:Name="HomeList" ColumnSpacing="8" RowSpacing="8"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="SettingsHomeList">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer x:Name="GeneralPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Key=Nav.General}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Language. The list itself is built in code-behind from Loc.Available so
                             the languages DevDX ships are declared in exactly one place. Changing
                             it takes effect immediately: every window is rebuilt in place, which
                             is why there is no "restart to finish" prompt here. -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xF2B7;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Language}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.LanguageDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Language}"
                                          SelectionChanged="LanguageChoice_SelectionChanged" />
                            </Grid>
                        </Border>

                        <!-- Open-window indicators -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.OpenIndicators}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.OpenIndicatorsDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OpenIndicatorsSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.OpenIndicators}"
                                              Toggled="OpenIndicatorsSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Reuse tool windows -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A7;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.ReuseToolWindows}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ReuseToolWindowsDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ReuseWindowsSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.ReuseToolWindows}"
                                              Toggled="ReuseWindowsSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Startup -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Startup}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.StartupDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="{loc:Localize Key=Settings.Startup}"
                                                  Toggled="StartupSwitch_Toggled" />
                                </Grid>

                                <!-- Only ever shown on the packaged build, and only when Windows
                                     itself is holding the entry off: a startup task the user
                                     disabled in Task Manager cannot be re-enabled by the app, so
                                     the switch springs back and this says who can. -->
                                <muxc:InfoBar x:Name="StartupBlockedBar" IsOpen="False" IsClosable="True"
                                              Severity="Warning"
                                              Message="{loc:Localize Key=Settings.StartupBlocked}" />
                            </StackPanel>
                        </Border>

                        <!-- Backup: export the whole configuration, or restore one. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8B5;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Backup}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.BackupDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="{loc:Localize Key=Settings.Export}"
                                                Click="Export_Click" />
                                        <Button Content="{loc:Localize Key=Settings.Import}"
                                                Click="Import_Click" />
                                    </StackPanel>
                                </Grid>

                                <muxc:InfoBar x:Name="BackupBar" IsOpen="False" IsClosable="True"
                                              Severity="Success" />
                            </StackPanel>
                        </Border>

                        <!-- Maintenance -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE777;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.ResetSection}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ResetSectionDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:Localize Key=Settings.Reset}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Click="Reset_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== APPEARANCE ====================
                     Personalization that applies to the whole app: how big the cells are, how the
                     glass is tinted, and whether icons swell under the cursor. -->
                <ScrollViewer x:Name="AppearancePanel" Visibility="Collapsed"
                              AutomationProperties.AutomationId="SettingsAppearancePanel">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Key=Nav.Appearance}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Theme -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE771;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Theme}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ThemeDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Theme}"
                                          SelectionChanged="ThemeChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.Light}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.Dark}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.System}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Icon size / density -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE740;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Density}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.DensityDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="DensityChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Density}"
                                          SelectionChanged="DensityChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=Density.Small}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Density.Medium}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Density.Large}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Glass frostiness -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE81E;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Glass}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.GlassDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Percent rather than 0–1: a slider reading "0.9" means nothing
                                     to the person moving it. -->
                                <Slider x:Name="GlassSlider" Grid.Column="2" Width="170"
                                        Minimum="30" Maximum="100" StepFrequency="5"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        AutomationProperties.Name="{loc:Localize Key=Settings.Glass}"
                                        ValueChanged="GlassSlider_ValueChanged" />
                            </Grid>
                        </Border>

                        <!-- Accent tint -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE790;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.AccentTint}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.AccentTintDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AccentTintSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.AccentTint}"
                                              Toggled="AccentTintSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Magnification -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A3;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Magnify}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.MagnifyDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MagnifySwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.Magnify}"
                                              Toggled="MagnifySwitch_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== SHORTCUTS ====================
                     Everything system-wide DevDX registers with Windows, in one place: the
                     shortcut that summons the dock, the one that opens quick-launch search, and
                     the master switch for the per-item ones (assigned from an icon's own menu). -->
                <ScrollViewer x:Name="ShortcutsPanel" Visibility="Collapsed"
                              AutomationProperties.AutomationId="SettingsShortcutsPanel">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Key=Nav.Shortcuts}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Summon the dock -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE765;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Hotkey}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.HotkeyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- The on/off switch sits at the right edge of the card, in
                                         line with every other toggle; the capture button (added in
                                         code-behind, see HotkeyCaptureButton) stacks under it. -->
                                    <StackPanel x:Name="HotkeyColumn" Grid.Column="2"
                                                Orientation="Vertical" Spacing="10"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <ToggleSwitch x:Name="HotkeySwitch"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      AutomationProperties.Name="{loc:Localize Key=Settings.Hotkey}"
                                                      Toggled="HotkeySwitch_Toggled" />
                                    </StackPanel>
                                </Grid>

                                <muxc:InfoBar x:Name="HotkeyBar" IsOpen="False" IsClosable="False"
                                              Severity="Warning" />
                            </StackPanel>
                        </Border>

                        <!-- Quick-launch search -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE721;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.SearchHotkey}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.SearchHotkeyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="SearchHotkeyColumn" Grid.Column="2"
                                                VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <muxc:InfoBar x:Name="SearchHotkeyBar" IsOpen="False" IsClosable="False"
                                              Severity="Warning" />
                            </StackPanel>
                        </Border>

                        <!-- Per-item shortcuts -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C1;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.ItemHotkeys}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.ItemHotkeysDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ItemHotkeysSwitch" Grid.Column="2"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="{loc:Localize Key=Settings.ItemHotkeys}"
                                                  Toggled="ItemHotkeysSwitch_Toggled" />
                                </Grid>

                                <!-- What is currently assigned, so the shortcuts aren't invisible
                                     once they're spread across a dozen right-click menus. -->
                                <StackPanel x:Name="ItemHotkeyList" Spacing="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== DOCK ====================
                     Where and how the one strip sits on screen. Built in code-behind (DockList):
                     the number of monitors to offer is only known at runtime. -->
                <Grid x:Name="DockPanel" Visibility="Collapsed" RowSpacing="12"
                      AutomationProperties.AutomationId="SettingsDockPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Localize Key=Nav.Dock}"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="{loc:Localize Key=Dock.Hint}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="DockList" Spacing="8" HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="SettingsDockList" />
                    </ScrollViewer>
                </Grid>

                <!-- ==================== TOOLS ==================== -->
                <Grid x:Name="ToolsPanel" Visibility="Collapsed" RowSpacing="12"
                      AutomationProperties.AutomationId="SettingsToolsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Localize Key=Nav.Tools}"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1"
                               Text="{loc:Localize Key=Tools.Hint}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Two cards to a row, same shape as Home above. -->
                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <Grid x:Name="ToolsList" ColumnSpacing="8" RowSpacing="8"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="SettingsToolsList">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== ABOUT ==================== -->
                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <!-- Stretch so the cards fill the page width whether or not the Privacy
                         expander is open (a Left-aligned panel would size to its content and
                         only widen once the long expanded text appears). -->
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Localize Key=Nav.About}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Identity + developer -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <!-- The real app logo, not a stand-in glyph. targetsize-256 is the
                                         largest unpadded variant, so it stays crisp at 56px. -->
                                    <Border Width="56" Height="56" CornerRadius="12">
                                        <Image Source="ms-appx:///Images/Square44x44Logo.targetsize-256.png"
                                               Width="56" Height="56" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="DevDX" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="VersionText"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{loc:Localize Key=About.Tagline}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{loc:Localize Key=About.Credits}" />

                                <!-- HyperlinkButton opens the URI with the default browser; no
                                     code-behind needed. Margin trims the button's built-in padding
                                     so the links line up with the text above. -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0">
                                    <HyperlinkButton Content="{loc:Localize Key=About.SourceCode}"
                                                     NavigateUri="https://github.com/framedparadox/dev-dx" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.ReportIssue}"
                                                     NavigateUri="https://github.com/framedparadox/dev-dx/issues" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.License}"
                                                     NavigateUri="https://github.com/framedparadox/dev-dx/blob/main/LICENSE" />
                                    <!-- The same document whose URL the Microsoft Store listing
                                         carries; Store policy 10.5.1 requires a Win32 product to
                                         have one, and having it in-app too costs nothing. -->
                                    <HyperlinkButton Content="{loc:Localize Key=About.PrivacyPolicy}"
                                                     NavigateUri="https://github.com/framedparadox/dev-dx/blob/main/docs/privacy-policy.md" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Update check. Off by default and the only thing in the whole app that
                             would ever contact the network (see Privacy, below). Collapsed
                             entirely on the Microsoft Store build, which updates through the
                             Store — see DevDxManager.UpdateChecksSupported. -->
                        <Border x:Name="UpdateCard" Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE895;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Updates}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.UpdatesDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <ToggleSwitch x:Name="UpdatesSwitch"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      AutomationProperties.Name="{loc:Localize Key=Settings.Updates}"
                                                      Toggled="UpdatesSwitch_Toggled" />
                                        <Button x:Name="CheckUpdatesButton" MinWidth="150"
                                                HorizontalAlignment="Right"
                                                Content="{loc:Localize Key=Update.CheckNow}"
                                                Click="CheckUpdates_Click" />
                                    </StackPanel>
                                </Grid>

                                <muxc:InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False"
                                              Severity="Informational" />
                            </StackPanel>
                        </Border>

                        <!-- Privacy: collapsed by default; expand for the details. -->
                        <Expander HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Localize Key=About.Privacy}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=About.PrivacyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyLocal}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyLocalBody}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyOffline}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyOfflineBody}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyTracking}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyTrackingBody}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
